{
  "openapi": "3.1.0",
  "info": {
    "title": "DeveloperBingo API",
    "version": "0.1.0"
  },
  "paths": {
    "/games/{code}/history": {
      "get": {
        "summary": "Read Game History",
        "description": "An ended game's record. Public: anyone with the game's code may read it.",
        "operationId": "read_game_history_games__code__history_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/games": {
      "post": {
        "summary": "Create Game",
        "description": "Create a game on the default pool, or on the saved pool named by `pool_id`.",
        "operationId": "create_game_games_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CreateGameRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostLink"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pools/default": {
      "get": {
        "summary": "Read Default Pool",
        "operationId": "read_default_pool_pools_default_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pools": {
      "get": {
        "summary": "List Pools",
        "operationId": "list_pools_pools_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PoolSummaryResponse"
                  },
                  "type": "array",
                  "title": "Response List Pools Pools Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save Pool",
        "description": "Save a custom pool for every host to use, once it meets the pool rules.",
        "operationId": "save_pool_pools_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPool"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolSummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolRefused"
                }
              }
            }
          }
        }
      }
    },
    "/pools/{pool_id}": {
      "get": {
        "summary": "Read Pool",
        "operationId": "read_pool_pools__pool_id__get",
        "parameters": [
          {
            "name": "pool_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Pool Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/games/{code}/pool": {
      "get": {
        "summary": "Read Game Pool",
        "operationId": "read_game_pool_games__code__pool_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamePoolResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClaimLogEntry": {
        "description": "One decided claim as the host sees it. A refused claim says why, as a wire error code.",
        "properties": {
          "player": {
            "title": "Player",
            "type": "string"
          },
          "prize": {
            "$ref": "#/components/schemas/Prize"
          },
          "accepted": {
            "title": "Accepted",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "player",
          "prize",
          "accepted",
          "error"
        ],
        "title": "ClaimLogEntry",
        "type": "object"
      },
      "CreateGameRequest": {
        "properties": {
          "pool_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pool Id"
          }
        },
        "type": "object",
        "title": "CreateGameRequest"
      },
      "DrawAnnouncement": {
        "description": "A draw as players see it: its place in the game, the topic and its explanation.",
        "properties": {
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          }
        },
        "required": [
          "position",
          "name",
          "explanation"
        ],
        "title": "DrawAnnouncement",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Why a request was refused. Each engine error declares the code it maps to.",
        "enum": [
          "not_found",
          "not_host",
          "name_taken",
          "game_full",
          "already_started",
          "game_ended",
          "not_started",
          "no_topics_left",
          "not_a_player",
          "not_drawn",
          "not_on_ticket",
          "claim_not_valid",
          "prize_taken",
          "already_joined",
          "not_joined",
          "unknown_prize",
          "invalid_message",
          "settlement_open",
          "claim_pending"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "GameHistoryResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "reason": {
            "type": "string",
            "enum": [
              "full_house",
              "host"
            ],
            "title": "Reason"
          },
          "pool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pool Name"
          },
          "draws": {
            "items": {
              "$ref": "#/components/schemas/DrawAnnouncement"
            },
            "type": "array",
            "title": "Draws"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ClaimLogEntry"
            },
            "type": "array",
            "title": "Claims"
          },
          "winners": {
            "items": {
              "$ref": "#/components/schemas/PrizeBoardEntry"
            },
            "type": "array",
            "title": "Winners"
          }
        },
        "type": "object",
        "required": [
          "code",
          "reason",
          "pool_name",
          "draws",
          "claims",
          "winners"
        ],
        "title": "GameHistoryResponse",
        "description": "An ended game: its draws in order, every claim with its outcome, and who won each prize."
      },
      "GamePoolResponse": {
        "properties": {
          "columns": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/TopicResponse"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Columns"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "columns",
          "name"
        ],
        "title": "GamePoolResponse",
        "description": "A game's pool, with the name it was chosen under (none if the game was made without one)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse"
      },
      "HostLink": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "host_token": {
            "type": "string",
            "title": "Host Token"
          }
        },
        "type": "object",
        "required": [
          "code",
          "host_token"
        ],
        "title": "HostLink",
        "description": "The private handle on one game: whoever holds it controls that game.\n\nIt is what creating a game returns, and what every host command sends."
      },
      "NewPool": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicResponse"
            },
            "type": "array",
            "title": "Topics"
          }
        },
        "type": "object",
        "required": [
          "name",
          "topics"
        ],
        "title": "NewPool"
      },
      "PoolRefusal": {
        "properties": {
          "rule": {
            "type": "string",
            "title": "Rule"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "rule",
          "message"
        ],
        "title": "PoolRefusal"
      },
      "PoolRefused": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/PoolRefusal"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "PoolRefused"
      },
      "PoolResponse": {
        "description": "A pool as columns of topics.",
        "properties": {
          "columns": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/TopicResponse"
              },
              "type": "array"
            },
            "title": "Columns",
            "type": "array"
          }
        },
        "required": [
          "columns"
        ],
        "title": "PoolResponse",
        "type": "object"
      },
      "PoolSummaryResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "is_default"
        ],
        "title": "PoolSummaryResponse"
      },
      "Prize": {
        "description": "The prizes a game can award, in the order the prize board lists them.\n\nThe value is the name the wire uses.",
        "enum": [
          "early_five",
          "top_line",
          "middle_line",
          "bottom_line",
          "four_corners",
          "full_house"
        ],
        "title": "Prize",
        "type": "string"
      },
      "PrizeBoardEntry": {
        "description": "One prize, and the names of the players it was awarded to. Empty while it is open.",
        "properties": {
          "prize": {
            "$ref": "#/components/schemas/Prize"
          },
          "awarded_to": {
            "items": {
              "type": "string"
            },
            "title": "Awarded To",
            "type": "array"
          }
        },
        "required": [
          "prize",
          "awarded_to"
        ],
        "title": "PrizeBoardEntry",
        "type": "object"
      },
      "TopicResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          }
        },
        "required": [
          "name",
          "explanation"
        ],
        "title": "TopicResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Accepted": {
        "properties": {
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Accepted",
        "type": "object"
      },
      "ClaimPayload": {
        "properties": {
          "prize": {
            "title": "Prize",
            "type": "string"
          }
        },
        "required": [
          "prize"
        ],
        "title": "ClaimPayload",
        "type": "object"
      },
      "ClaimSettled": {
        "description": "One player's own claim, decided at the close of its settlement window. A refusal says why.",
        "properties": {
          "prize": {
            "$ref": "#/components/schemas/Prize"
          },
          "accepted": {
            "title": "Accepted",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "prize",
          "accepted",
          "error"
        ],
        "title": "ClaimSettled",
        "type": "object"
      },
      "ClaimWaiting": {
        "description": "A valid claim is in its prize's settlement window. Its result follows as one `claim_settled`\nevent when the window closes.",
        "properties": {
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "waiting": {
            "const": true,
            "default": true,
            "title": "Waiting",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "waiting"
        ],
        "title": "ClaimWaiting",
        "type": "object"
      },
      "DrawAck": {
        "properties": {
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "draw": {
            "$ref": "#/components/schemas/DrawAnnouncement"
          }
        },
        "required": [
          "ok",
          "draw"
        ],
        "title": "DrawAck",
        "type": "object"
      },
      "GameEnded": {
        "description": "The game is over: someone claimed the full house, or the host ended it.",
        "properties": {
          "reason": {
            "enum": [
              "full_house",
              "host"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "GameEnded",
        "type": "object"
      },
      "GameSnapshot": {
        "description": "What a client needs to show a game from scratch: where it stands, who is in it, what has\nbeen drawn and who has been awarded what.",
        "properties": {
          "status": {
            "enum": [
              "lobby",
              "started",
              "ended"
            ],
            "title": "Status",
            "type": "string"
          },
          "end_reason": {
            "anyOf": [
              {
                "enum": [
                  "full_house",
                  "host"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Reason"
          },
          "players": {
            "items": {
              "type": "string"
            },
            "title": "Players",
            "type": "array"
          },
          "draws": {
            "items": {
              "$ref": "#/components/schemas/DrawAnnouncement"
            },
            "title": "Draws",
            "type": "array"
          },
          "prizes": {
            "items": {
              "$ref": "#/components/schemas/PrizeBoardEntry"
            },
            "title": "Prizes",
            "type": "array"
          }
        },
        "required": [
          "status",
          "end_reason",
          "players",
          "draws",
          "prizes"
        ],
        "title": "GameSnapshot",
        "type": "object"
      },
      "GameStarted": {
        "properties": {},
        "title": "GameStarted",
        "type": "object"
      },
      "JoinAck": {
        "description": "A player's snapshot: the game, plus their own ticket, ticks and pending claims.",
        "properties": {
          "status": {
            "enum": [
              "lobby",
              "started",
              "ended"
            ],
            "title": "Status",
            "type": "string"
          },
          "end_reason": {
            "anyOf": [
              {
                "enum": [
                  "full_house",
                  "host"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Reason"
          },
          "players": {
            "items": {
              "type": "string"
            },
            "title": "Players",
            "type": "array"
          },
          "draws": {
            "items": {
              "$ref": "#/components/schemas/DrawAnnouncement"
            },
            "title": "Draws",
            "type": "array"
          },
          "prizes": {
            "items": {
              "$ref": "#/components/schemas/PrizeBoardEntry"
            },
            "title": "Prizes",
            "type": "array"
          },
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ticket": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "title": "Ticket",
            "type": "array"
          },
          "ticks": {
            "items": {
              "type": "string"
            },
            "title": "Ticks",
            "type": "array"
          },
          "pending_claims": {
            "items": {
              "$ref": "#/components/schemas/Prize"
            },
            "title": "Pending Claims",
            "type": "array"
          },
          "decided_claims": {
            "items": {
              "$ref": "#/components/schemas/ClaimSettled"
            },
            "title": "Decided Claims",
            "type": "array"
          },
          "rejoin_token": {
            "title": "Rejoin Token",
            "type": "string"
          }
        },
        "required": [
          "status",
          "end_reason",
          "players",
          "draws",
          "prizes",
          "ok",
          "name",
          "ticket",
          "ticks",
          "pending_claims",
          "decided_claims",
          "rejoin_token"
        ],
        "title": "JoinAck",
        "type": "object"
      },
      "JoinPayload": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rejoin_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rejoin Token"
          }
        },
        "required": [
          "code",
          "name",
          "rejoin_token"
        ],
        "title": "JoinPayload",
        "type": "object"
      },
      "LobbyUpdated": {
        "properties": {
          "players": {
            "items": {
              "type": "string"
            },
            "title": "Players",
            "type": "array"
          }
        },
        "required": [
          "players"
        ],
        "title": "LobbyUpdated",
        "type": "object"
      },
      "PrizeAwarded": {
        "properties": {
          "prize": {
            "$ref": "#/components/schemas/Prize"
          },
          "awarded_to": {
            "items": {
              "type": "string"
            },
            "title": "Awarded To",
            "type": "array"
          }
        },
        "required": [
          "prize",
          "awarded_to"
        ],
        "title": "PrizeAwarded",
        "type": "object"
      },
      "Refusal": {
        "properties": {
          "ok": {
            "const": false,
            "default": false,
            "title": "Ok",
