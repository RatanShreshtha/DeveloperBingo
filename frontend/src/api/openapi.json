{
  "openapi": "3.1.0",
  "info": {
    "title": "DeveloperBingo API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/games": {
      "post": {
        "summary": "Create Game",
        "operationId": "create_game_games_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostLink"
                }
              }
            }
          }
        }
      }
    },
    "/games/{code}/lobby": {
      "get": {
        "summary": "Read Lobby",
        "operationId": "read_lobby_games__code__lobby_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "x-host-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Host-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/games/{code}/draws": {
      "get": {
        "summary": "Read Draw History",
        "description": "Every draw so far, in order. Public, so a player who arrives late can catch up.",
        "operationId": "read_draw_history_games__code__draws_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrawHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pools/default": {
      "get": {
        "summary": "Read Default Pool",
        "operationId": "read_default_pool_pools_default_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DrawAnnouncement": {
        "description": "A draw as players see it: its place in the game, the topic and its explanation.",
        "properties": {
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          }
        },
        "required": [
          "position",
          "name",
          "explanation"
        ],
        "title": "DrawAnnouncement",
        "type": "object"
      },
      "DrawHistoryResponse": {
        "properties": {
          "draws": {
            "items": {
              "$ref": "#/components/schemas/DrawAnnouncement"
            },
            "type": "array",
            "title": "Draws"
          }
        },
        "type": "object",
        "required": [
          "draws"
        ],
        "title": "DrawHistoryResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse"
      },
      "HostLink": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "host_token": {
            "type": "string",
            "title": "Host Token"
          }
        },
        "type": "object",
        "required": [
          "code",
          "host_token"
        ],
        "title": "HostLink",
        "description": "The private handle on one game: whoever holds it controls that game.\n\nIt is what creating a game returns, and what every host command sends."
      },
      "LobbyResponse": {
        "properties": {
          "players": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Players"
          }
        },
        "type": "object",
        "required": [
          "players"
        ],
        "title": "LobbyResponse"
      },
      "PoolResponse": {
        "properties": {
          "columns": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/TopicResponse"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Columns"
          }
        },
        "type": "object",
        "required": [
          "columns"
        ],
        "title": "PoolResponse"
      },
      "TopicResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "name",
          "explanation"
        ],
        "title": "TopicResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Accepted": {
        "properties": {
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Accepted",
        "type": "object"
      },
      "ClaimPayload": {
        "properties": {
          "prize": {
            "title": "Prize",
            "type": "string"
          }
        },
        "required": [
          "prize"
        ],
        "title": "ClaimPayload",
        "type": "object"
      },
      "DrawAck": {
        "properties": {
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "draw": {
            "$ref": "#/components/schemas/DrawAnnouncement"
          }
        },
        "required": [
          "ok",
          "draw"
        ],
        "title": "DrawAck",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Why a request was refused. Each engine error declares the code it maps to.",
        "enum": [
          "not_found",
          "not_host",
          "name_taken",
          "game_full",
          "already_started",
          "not_started",
          "no_topics_left",
          "not_a_player",
          "not_drawn",
          "not_on_ticket",
          "claim_not_valid",
          "prize_taken",
          "already_joined",
          "not_joined",
          "unknown_prize",
          "invalid_message"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "GameStarted": {
        "properties": {},
        "title": "GameStarted",
        "type": "object"
      },
      "JoinAck": {
        "properties": {
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "ticket": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "title": "Ticket",
            "type": "array"
          },
          "ticks": {
            "items": {
              "type": "string"
            },
            "title": "Ticks",
            "type": "array"
          },
          "prizes": {
            "items": {
              "$ref": "#/components/schemas/PrizeBoardEntry"
            },
            "title": "Prizes",
            "type": "array"
          }
        },
        "required": [
          "ok",
          "ticket",
          "ticks",
          "prizes"
        ],
        "title": "JoinAck",
        "type": "object"
      },
      "JoinPayload": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "title": "JoinPayload",
        "type": "object"
      },
      "LobbyUpdated": {
        "properties": {
          "players": {
            "items": {
              "type": "string"
            },
            "title": "Players",
            "type": "array"
          }
        },
        "required": [
          "players"
        ],
        "title": "LobbyUpdated",
        "type": "object"
      },
      "Prize": {
        "description": "The prizes a game can award, in the order the prize board lists them.\n\nThe value is the name the wire uses.",
        "enum": [
          "early_five",
          "top_line",
          "middle_line",
          "bottom_line",
          "four_corners",
          "full_house"
        ],
        "title": "Prize",
        "type": "string"
      },
      "PrizeAwarded": {
        "properties": {
          "prize": {
            "$ref": "#/components/schemas/Prize"
          },
          "awarded_to": {
            "items": {
              "type": "string"
            },
            "title": "Awarded To",
            "type": "array"
          }
        },
        "required": [
          "prize",
          "awarded_to"
        ],
        "title": "PrizeAwarded",
        "type": "object"
      },
      "PrizeBoardEntry": {
        "description": "One prize, and the names of the players it was awarded to. Empty while it is open.",
        "properties": {
          "prize": {
            "$ref": "#/components/schemas/Prize"
          },
          "awarded_to": {
            "items": {
              "type": "string"
            },
            "title": "Awarded To",
            "type": "array"
          }
        },
        "required": [
          "prize",
          "awarded_to"
        ],
        "title": "PrizeBoardEntry",
        "type": "object"
      },
      "Refusal": {
        "properties": {
          "ok": {
            "const": false,
            "default": false,
            "title": "Ok",
            "type": "boolean"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "title": "Refusal",
        "type": "object"
      },
      "TickPayload": {
        "properties": {
          "topic": {
            "title": "Topic",
            "type": "string"
          }
        },
        "required": [
          "topic"
        ],
        "title": "TickPayload",
        "type": "object"
      },
      "WatchAck": {
        "properties": {
          "ok": {
            "const": true,
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "players": {
            "items": {
              "type": "string"
            },
            "title": "Players",
            "type": "array"
          },
          "prizes": {
            "items": {
              "$ref": "#/components/schemas/PrizeBoardEntry"
            },
            "title": "Prizes",
            "type": "array"
          }
        },
        "required": [
          "ok",
          "players",
          "prizes"
        ],
        "title": "WatchAck",
        "type": "object"
      }
    }
  }
}
